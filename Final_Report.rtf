\pard\sa200\sl276\slmult1\cf1 PREPARED BY: DHANUSHKUMAR S\par
\cf2\fs32 1-PROJECT OVERVIEW\par
    \cf0\fs24 This project analyzes food delivery data to understand revenue, customer behavior, restaurant performance, order trends, and delivery efficiency.\par
 Five datasets\f1\emdash Orders, Customers, Restaurants, Delivery, and Ratings\emdash are cleaned and analyzed using Python and SQL. Power BI is used to create an interactive dashboard to visualize business performance and identify insights for better decision-making.\par
\cf2\f0\fs32\lang16393 2-PROJECT OBJECTIVES\par

\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li720\sa200\sl276\slmult1  \cf0\fs24 To analyze food delivery business performance.\par
{\pntext\f2\'B7\tab} To identify top-performing restaurants and popular cuisines.\par
{\pntext\f2\'B7\tab}  To understand customer spending and order behavior.\par
{\pntext\f2\'B7\tab} To analyze revenue, payment modes, and order status.\par
{\pntext\f2\'B7\tab} To evaluate delivery time and customer ratings.\par
{\pntext\f2\'B7\tab} To create an interactive Power BI dashboard for better businessdecisionmaking.\f1\lang9\par

\pard\sa200\sl276\slmult1\cf2\f0\fs32\lang16393 3-DATASET DESCRIPTION\par

\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li720\sa200\sl276\slmult1\cf0\fs24      \b Order Dataset : \b0 Contains order details, order value, payment mode, order status, and order date.\b\par
{\pntext\f2\'B7\tab}     Customer Dataset :\b0 Contains customer information, city, and signup date.\b\par
{\pntext\f2\'B7\tab}     Restuarants Dataset :\b0 Contains restaurant names, cuisine types, city, and ratings.\b\par
{\pntext\f2\'B7\tab}     Delivery Dataset :\b0 Contains delivery details, distance, delivery time, and delay status.\par
{\pntext\f2\'B7\tab}\b      Ratings Dataset :\b0 Contains customer ratings and feedback for food orders.\par

\pard\sa200\sl276\slmult1\cf2\fs32 4-TOOLS AND TECHNOLOGY USED\par

\pard{\pntext\f2\'B7\tab}{\*\pn\pnlvlblt\pnf2\pnindent0{\pntxtb\'B7}}\fi-360\li720\sa200\sl276\slmult1       \cf0\b\fs24 Python: \b0 Used for data cleaning, data processing, and exploratory data analysis.\b\par
{\pntext\f2\'B7\tab}      Pandas and Numpy:\b0 Used for data manipulation and numerical operations.\b\par
{\pntext\f2\'B7\tab}      Matplotlib: \b0 Used to create charts and visualizations.\b\par
{\pntext\f2\'B7\tab}     My SQL: \b0 Used for data storage, SQL queries, and business analysis.\par
{\pntext\f2\'B7\tab}\b     Power BI:\b0 Used to create an interactive dashboard and visualize business insights.\par
{\pntext\f2\'B7\tab}\b    Jupyter Notebook:\b0 Used to execute Python code and perform data analysis.\cf2\b\par

